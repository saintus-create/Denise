---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="logo-grid grid-row grid-gap-2">
  <div class="tablet:grid-col-2 text-center">
    <Icon class="usa-icon size-8 md:size-12" name="simple-icons:react" />
  </div>
  <div class="tablet:grid-col-2 text-center">
    <Icon class="usa-icon size-8 md:size-12" name="simple-icons:svelte" />
  </div>
  <div class="tablet:grid-col-2 text-center">
    <Icon class="usa-icon size-8 md:size-12" name="simple-icons:astro" />
  </div>
  <div class="tablet:grid-col-2 text-center">
    <Icon class="usa-icon size-8 md:size-16" name="simple-icons:tailwindcss" />
  </div>
  <div class="tablet:grid-col-2 text-center">
    <Icon class="usa-icon size-8 md:size-12" name="simple-icons:alpinedotjs" />
  </div>
  <div class="tablet:grid-col-2 text-center">
    <Icon class="usa-icon size-8 md:size-16" name="simple-icons:vercel" />
  </div>
</div>
</div>
